{
  "name": "pulsechat",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=20.19.4 <25",
    "npm": ">=10 <12"
  },
  "dependencies": {
    "@expo/ui": "~57.0.11",
    "@noble/ciphers": "1.3.0",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@supabase/supabase-js": "^2.111.0",
    "aes-js": "3.1.2",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~57.0.13",
    "expo-constants": "~57.0.11",
    "expo-dev-client": "~57.0.12",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-image-manipulator": "~57.0.8",
    "expo-image-picker": "~57.0.5",
    "expo-linking": "~57.0.6",
    "expo-notifications": "~57.0.6",
    "expo-router": "~57.0.13",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "^2.0.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/aes-js": "^3.1.4",
    "@types/react": "~19.2.2",
    "eas-cli": "22.0.0",
    "esbuild": "0.25.11",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --no-warnings --test tests/*.test.mjs",
    "secrets:check": "node scripts/check-secrets.mjs",
    "audit:security": "npm audit --omit=dev --audit-level=high",
    "verify": "npm run typecheck && npm run lint && npm run test:unit && npm run secrets:check",
    "verify:security": "npm run verify && npm run audit:security",
    "qa:preflight": "node scripts/phase22-preflight.mjs",
    "qa:preflight:source": "node scripts/phase22-preflight.mjs --source-only",
    "qa:automated": "npm run verify:security && npm run qa:preflight:source",
    "check:android": "expo export --platform android --output-dir dist-phase22-android-check",
    "check:web": "expo export --platform web --output-dir dist-phase22-web-check",
    "qa:phase22": "npm run qa:automated && npm run check:android && npm run check:web",
    "audit:accessibility": "node scripts/phase23-accessibility-audit.mjs",
    "vendor:noble-ciphers": "node scripts/build-noble-ciphers-runtime.mjs",
    "check:android:phase23": "expo export --platform android --output-dir dist-phase23-android-check",
    "check:web:phase23": "expo export --platform web --output-dir dist-phase23-web-check",
    "qa:phase23": "npm run verify:security && npm run qa:preflight:source && npm run audit:accessibility && npm run check:android:phase23 && npm run check:web:phase23",
    "release:audit": "node scripts/phase24-release-audit.mjs",
    "release:audit:source": "node scripts/phase24-release-audit.mjs --source-only",
    "check:android:native": "node scripts/phase24-native-smoke.mjs",
    "check:android:native:source": "node scripts/phase24-native-smoke.mjs --source-only",
    "check:android:phase24": "node scripts/phase24-expo-export.mjs android dist-phase24-android-check",
    "check:web:phase24": "node scripts/phase24-expo-export.mjs web dist-phase24-web-check",
    "release:gate:configured": "npm run qa:preflight && npm run release:audit && npm run check:android:native",
    "build:android:development": "eas build --platform android --profile development --non-interactive",
    "build:android:preview": "eas build --platform android --profile preview --non-interactive",
    "build:android:production": "eas build --platform android --profile production --non-interactive",
    "qa:phase24": "npm run vendor:noble-ciphers && npm run verify:security && npm run qa:preflight:source && npm run audit:accessibility && npm run release:audit:source && npm run check:android:native:source && npm run check:android:phase24 && npm run check:web:phase24",
    "play:audit": "node scripts/phase25-play-readiness.mjs",
    "play:audit:source": "node scripts/phase25-play-readiness.mjs --source-only",
    "play:render-public": "node scripts/phase25-render-public.mjs",
    "play:prepare": "npm run play:audit && npm run play:render-public",
    "check:android:phase25": "node scripts/phase24-expo-export.mjs android dist-phase25-android-check",
    "check:web:phase25": "node scripts/phase24-expo-export.mjs web dist-phase25-web-check",
    "qa:phase25": "npm run vendor:noble-ciphers && npm run verify:security && npm run qa:preflight:source && npm run audit:accessibility && npm run release:audit:source && npm run check:android:native:source && npm run play:audit:source && npm run check:android:phase25 && npm run check:web:phase25"
  },
  "private": true
}
